<local:WorkspaceView x:Class="WgsDfe.Desktop.DfeInspectorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:WgsDfe.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Inspecionar DF-e e Visualizar Nota" Background="{StaticResource CanvasBrush}">
 <local:WorkspaceView.Resources><Style TargetType="Button" BasedOn="{StaticResource AppButton}"><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="0,0,8,6"/></Style></local:WorkspaceView.Resources>
 <Grid Margin="{StaticResource PageInset}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel><TextBlock Text="Inspecionar DF-e &amp; Espelho da Nota" Style="{StaticResource PageTitle}"/><TextBlock Text="Confira uma chave ou abra um arquivo XML local com visualização gráfica de DANFE / DACTE e tributação completa (Modelos 55, 57, 62, 65 e 67)." Style="{StaticResource Caption}" Margin="0,4,0,10"/></StackPanel>
 <TextBox Grid.Row="1" x:Name="KeyBox" Padding="8,6" MaxLength="4096" FontFamily="{x:Static local:Typography.Mono}" FontSize="14" ToolTip="Cole a chave com ou sem espaços"/>
 <WrapPanel Grid.Row="2" x:Name="Actions" Margin="0,8,0,8"><Button Content="Abrir e visualizar XML (DANFE)" local:Ui.Icon="&#xE8A5;" Style="{StaticResource PrimaryButton}" Click="Xml_Click"/><Button Content="Validar chave" Click="Key_Click"/><Button Content="Copiar chave" Click="CopyKey_Click"/><Button Content="Limpar" Click="Clear_Click"/></WrapPanel>
 <TextBlock Grid.Row="3" x:Name="Message" TextWrapping="Wrap" Foreground="#99520A" Margin="0,0,0,8"/>
 <TabControl Grid.Row="4" x:Name="InspectorTabs" Padding="4">
  <TabItem Header="Espelho Gráfico da Nota Fiscal (DANFE / Tributação)">
   <local:DanfeViewerControl x:Name="DanfeViewer"/>
  </TabItem>
  <TabItem Header="Resumo Técnico e Metadados">
   <TextBox x:Name="Result" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="14" FontFamily="{x:Static local:Typography.Mono}" FontSize="13"/>
  </TabItem>
 </TabControl>
 <StackPanel Grid.Row="5"><ProgressBar x:Name="BusyBar" Height="4" IsIndeterminate="True" Visibility="Collapsed" Margin="0,8,0,0"/><TextBlock Text="A leitura local exibe o espelho completo do XML sem alterar o acervo." TextWrapping="Wrap" Foreground="#69776F" Margin="0,6,0,0"/></StackPanel>
 </Grid>
</local:WorkspaceView>
