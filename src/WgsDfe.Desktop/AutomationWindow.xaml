<local:WorkspaceView x:Class="WgsDfe.Desktop.AutomationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:WgsDfe.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Automação — WGS DF-e Manager" Background="{StaticResource CanvasBrush}">
 <local:WorkspaceView.Resources><Style TargetType="Button" BasedOn="{StaticResource AppButton}"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,8,8"/></Style><Style TargetType="TextBox" BasedOn="{StaticResource AppTextBox}"><Setter Property="Padding" Value="6"/></Style><Style TargetType="ComboBox" BasedOn="{StaticResource AppComboBox}"><Setter Property="Padding" Value="6"/></Style></local:WorkspaceView.Resources>
 <Grid Margin="{StaticResource PageInset}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel><TextBlock Text="Sincronização automática" Style="{StaticResource PageTitle}"/><TextBlock Text="Horários diários por empresa e fonte. Requer aplicativo aberto e certificado associado. Cooldowns da fonte continuam valendo." TextWrapping="Wrap" Margin="0,6,0,12"/>
 <WrapPanel><CheckBox x:Name="Consent" Content="Autorizo consultas oficiais automáticas nesta sessão" VerticalAlignment="Center" Margin="0,0,16,0"/><Button x:Name="ArmButton" Content="Habilitar nesta sessão" Click="Arm_Click"/><Button Content="Pausar e cancelar em andamento" Click="Pause_Click"/><Button Content="Atualizar" Click="Refresh_Click"/></WrapPanel><TextBlock x:Name="SessionText" FontWeight="SemiBold" Margin="0,8,0,12"/></StackPanel>
 <WrapPanel x:Name="Editor" Grid.Row="1" Margin="0,0,0,10">
  <StackPanel Width="320" Margin="0,0,12,12"><TextBlock Text="Empresa"/><ComboBox x:Name="CompanyBox" DisplayMemberPath="Name" SelectedValuePath="Id" IsTextSearchEnabled="True" Margin="0,4,0,0"/></StackPanel>
  <StackPanel Width="220" Margin="0,0,12,12"><TextBlock Text="Fonte"/><ComboBox x:Name="SourceBox" DisplayMemberPath="Label" SelectedValuePath="Code" SelectionChanged="Source_Changed" Margin="0,4,0,0"/></StackPanel>
  <StackPanel Visibility="Collapsed" Width="170" Margin="0,0,12,12"><TextBlock Text="Ambiente"/><ComboBox x:Name="EnvironmentBox" SelectedIndex="0" Margin="0,4,0,0"><ComboBoxItem Content="Produção"/><ComboBoxItem Content="Homologação"/></ComboBox></StackPanel>
  <StackPanel Width="110" Margin="0,0,12,12"><TextBlock Text="Hora (HH:mm)"/><TextBox x:Name="TimeBox" Text="06:00" MaxLength="5" Margin="0,4,0,0"/></StackPanel>
  <StackPanel Width="230" Margin="0,0,12,12"><TextBlock Text="Fuso"/><ComboBox x:Name="ZoneBox" SelectedIndex="0" Margin="0,4,0,0"><ComboBoxItem Content="America/Sao_Paulo"/><ComboBoxItem Content="UTC"/></ComboBox></StackPanel>
  <StackPanel Width="320" Margin="0,0,12,12"><TextBlock Text="Papel (fontes NF-e / NFC-e / NFCom)" TextWrapping="Wrap"/><ComboBox x:Name="ActorBox" SelectedIndex="2" Margin="0,4,0,0"><ComboBoxItem Content="Emitente"/><ComboBoxItem Content="Destinatário"/><ComboBoxItem Content="Qualquer dos dois"/></ComboBox></StackPanel>
  <StackPanel Width="220" Margin="0,0,12,12"><TextBlock Text="Conteúdo"/><ComboBox x:Name="PayloadBox" SelectedIndex="0" Margin="0,4,0,0"><ComboBoxItem Content="XML completo"/><ComboBoxItem Content="Somente chaves"/></ComboBox></StackPanel>
  <StackPanel Width="170" Margin="0,0,12,12"><TextBlock Text="Modelos CT-e"/><WrapPanel Margin="0,8,0,0"><CheckBox x:Name="CteBox" Content="CT-e" IsChecked="True" Margin="0,0,12,0"/><CheckBox x:Name="OsBox" Content="CT-e OS" IsChecked="True"/></WrapPanel></StackPanel>
  <StackPanel Width="110" Margin="0,0,12,12"><TextBlock Text="Lotes (1–100)"/><TextBox x:Name="PagesBox" Text="10" MaxLength="3" Margin="0,4,0,0"/></StackPanel>
  <CheckBox x:Name="EnabledBox" Content="Agendamento ativo" MinWidth="170" VerticalAlignment="Center" Margin="0,0,12,12"/>
 </WrapPanel> <WrapPanel Grid.Row="2" Margin="0,0,0,10"><Button Content="Novo horário" Click="New_Click"/><Button Content="Salvar agendamento" Click="Save_Click"/><Button Content="Pausar selecionado" Click="Disable_Click"/><Button Content="Excluir sem histórico" Click="Delete_Click"/><TextBlock x:Name="EditText" VerticalAlignment="Center"/></WrapPanel>
 <DataGrid Grid.Row="3" x:Name="SchedulesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="Selection_Changed"><DataGrid.Columns><DataGridTextColumn Header="Empresa" Binding="{Binding Company}" Width="*" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="Fonte" Binding="{Binding Source}" Width="135" ElementStyle="{StaticResource CellText}" MinWidth="135"/><DataGridTextColumn Header="Ambiente" Binding="{Binding Environment}" Width="95" ElementStyle="{StaticResource CellText}" MinWidth="95"/><DataGridTextColumn Header="Hora" Binding="{Binding Time}" Width="60" ElementStyle="{StaticResource CellText}" MinWidth="60"/><DataGridTextColumn Header="Fuso" Binding="{Binding Zone}" Width="145" ElementStyle="{StaticResource CellText}" MinWidth="145"/><DataGridTextColumn Header="Situação" Binding="{Binding State}" Width="85" ElementStyle="{StaticResource CellText}" MinWidth="85"/><DataGridTextColumn Header="Próxima (fuso escolhido)" Binding="{Binding Next}" Width="155" ElementStyle="{StaticResource CellText}" MinWidth="155"/><DataGridTextColumn Header="Último resultado" Binding="{Binding Result}" Width="220" ElementStyle="{StaticResource CellText}" MinWidth="220"/></DataGrid.Columns></DataGrid>
 <TextBlock Grid.Row="4" Text="Últimas 200 execuções · detalhes e NSU nas telas de consulta da fonte" FontWeight="SemiBold" Margin="0,12,0,6"/>
 <DataGrid Grid.Row="5" x:Name="RunsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Empresa" Binding="{Binding Company}" Width="*" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="Fonte" Binding="{Binding Source}" Width="140" ElementStyle="{StaticResource CellText}" MinWidth="140"/><DataGridTextColumn Header="Início (UTC)" Binding="{Binding StartedAtUtc, StringFormat=dd/MM/yyyy HH:mm:ss}" Width="160" ElementStyle="{StaticResource CellText}" MinWidth="160"/><DataGridTextColumn Header="Resultado" Binding="{Binding Result}" Width="2*" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="190" ElementStyle="{StaticResource CellText}" MinWidth="190"/></DataGrid.Columns></DataGrid>
 <StackPanel Grid.Row="6" Margin="0,10,0,0"><TextBlock x:Name="Message" TextWrapping="Wrap" Foreground="#475569"/><TextBlock Text="Fechar esta janela mantém a automação habilitada. Fechar o aplicativo a encerra; ao reabrir é necessário habilitar a sessão novamente." TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/></StackPanel>
 </Grid>
</local:WorkspaceView>
