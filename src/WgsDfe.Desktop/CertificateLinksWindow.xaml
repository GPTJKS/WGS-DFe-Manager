<local:WorkspaceView x:Class="WgsDfe.Desktop.CertificateLinksWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:WgsDfe.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Associar certificado às empresas">
 <local:WorkspaceView.Resources><Style TargetType="Button" BasedOn="{StaticResource AppButton}"><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="6"/></Style></local:WorkspaceView.Resources>
 <Grid Margin="{StaticResource PageInset}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel><TextBlock x:Name="TitleText" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="A associação é uma configuração local. Não comprova procuração ou vínculo junto à SEFAZ." TextWrapping="Wrap" Margin="0,8,0,12"/></StackPanel>
 <DockPanel Grid.Row="1" x:Name="SearchPanel"><Button DockPanel.Dock="Right" Content="Pesquisar" Click="Search_Click"/><TextBox x:Name="Search" Padding="7" MaxLength="200" ToolTip="Razão social, CNPJ ou município"/></DockPanel>
 <DataGrid Grid.Row="2" x:Name="Companies" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Extended" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Empresa (Ctrl/Shift para selecionar várias)" Binding="{Binding LegalName}" Width="*" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="CNPJ" Binding="{Binding Cnpj}" Width="180" ElementStyle="{StaticResource CellText}" MinWidth="180"/></DataGrid.Columns></DataGrid>
 <WrapPanel Grid.Row="3" x:Name="Controls"><Button Content="Anterior" Click="Previous_Click"/><TextBlock x:Name="PageText" VerticalAlignment="Center"/><Button Content="Próxima" Click="Next_Click"/><ComboBox x:Name="Source" Width="220" SelectedIndex="0" SelectedValuePath="Tag" Margin="8" Padding="6"><ComboBoxItem Content="Associação geral" Tag="DEFAULT"/><ComboBoxItem Content="NF-e — SEF/SC" Tag="SEF_SC_NFE"/><ComboBoxItem Content="NF-e — Nacional" Tag="NFE_NACIONAL"/><ComboBoxItem Content="CT-e / CT-e OS — Nacional" Tag="CTE"/><ComboBoxItem Content="NFC-e — SC" Tag="SEF_SC_NFCE"/><ComboBoxItem Content="NFCom — SC (contador)" Tag="NFCOM"/></ComboBox><Button Content="Associar selecionadas" Click="Associate_Click"/></WrapPanel>
 <TextBlock Grid.Row="4" Text="Associações atuais" FontWeight="SemiBold" Margin="0,8"/>
 <DataGrid Grid.Row="5" x:Name="Links" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Empresa" Binding="{Binding CompanyName}" Width="*" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="CNPJ" Binding="{Binding Cnpj}" Width="170" ElementStyle="{StaticResource CellText}" MinWidth="170"/><DataGridTextColumn Header="Fonte" Binding="{Binding ProviderCode}" Width="180" ElementStyle="{StaticResource CellText}" MinWidth="180"/></DataGrid.Columns></DataGrid>
 <StackPanel Grid.Row="6"><Button x:Name="UnlinkButton" Content="Remover associação selecionada" Click="Unlink_Click" HorizontalAlignment="Left"/><TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,8"/></StackPanel>
 </Grid>
</local:WorkspaceView>
