<local:WorkspaceView x:Class="WgsDfe.Desktop.CompanyImportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:WgsDfe.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Importar empresas" Background="{StaticResource CanvasBrush}">
 <Grid Margin="{StaticResource PageInset}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,16"><TextBlock Text="Conferência da importação" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="SummaryText" Margin="0,12,0,0" TextWrapping="Wrap"/><TextBlock Text="Somente as linhas prontas serão cadastradas. Empresas já existentes serão preservadas." Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel>
 <DataGrid x:Name="RowsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="Linha" Binding="{Binding RowNumber}" Width="60" ElementStyle="{StaticResource CellText}" MinWidth="60"/><DataGridTextColumn Header="CNPJ" Binding="{Binding Cnpj}" Width="160" ElementStyle="{StaticResource CellText}" MinWidth="160"/><DataGridTextColumn Header="Razão social" Binding="{Binding LegalName}" Width="*" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="Situação" Binding="{Binding Status}" Width="140" ElementStyle="{StaticResource CellText}" MinWidth="140"/><DataGridTextColumn Header="Motivo" Binding="{Binding Reason}" Width="2*" ElementStyle="{StaticResource CellText}"/></DataGrid.Columns></DataGrid>
 <StackPanel Grid.Row="2" Margin="0,14,0,0"><ProgressBar x:Name="ProgressBar" Height="7" Minimum="0"/><TextBlock x:Name="MessageText" Margin="0,10" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="ImportButton" Content="Importar linhas prontas" Padding="14,8" Margin="0,0,10,0" Click="Start_Click"/><Button x:Name="ReportButton" Content="Salvar relatório CSV" Padding="14,8" Margin="0,0,10,0" Click="Report_Click"/><Button x:Name="CloseButton" Content="Fechar" Padding="14,8" Click="Close_Click"/></StackPanel></StackPanel>
 </Grid>
</local:WorkspaceView>
