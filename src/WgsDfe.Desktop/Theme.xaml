 <Style x:Key="AppDatePicker" TargetType="DatePicker">
  <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}"/>
  <Setter Property="MinHeight" Value="28"/>
  <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
  <Setter Property="Background" Value="{StaticResource SoftBrush}"/>
  <Setter Property="BorderBrush" Value="#DFDCD4"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="SnapsToDevicePixels" Value="True"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="DatePicker">
     <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="{StaticResource ControlRadius}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
      <Grid>
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="26"/>
       </Grid.ColumnDefinitions>
       <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0" BorderThickness="0" Background="Transparent" Padding="7,3,1,3" VerticalContentAlignment="Center"/>
       <Button x:Name="PART_Button" Grid.Column="1" Focusable="False" Padding="0" Margin="0" MinHeight="24" Width="24" Background="Transparent" BorderThickness="0" ToolTip="Abrir calendário">
        <Button.Template>
         <ControlTemplate TargetType="Button">
          <Border Background="Transparent" CornerRadius="0,7,7,0">
           <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="12.5" Foreground="#E08A34" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
         </ControlTemplate>
        </Button.Template>
       </Button>
       <Popup x:Name="PART_Popup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"/>
      </Grid>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
       <Setter TargetName="Frame" Property="BorderBrush" Value="#18181B"/>
       <Setter TargetName="Frame" Property="Background" Value="#FFFFFF"/>
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
       <Setter TargetName="Frame" Property="BorderBrush" Value="#B8B2A6"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
       <Setter TargetName="Frame" Property="Opacity" Value="0.5"/>
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
