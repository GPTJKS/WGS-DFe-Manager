<local:WorkspaceView x:Class="WgsDfe.Desktop.HistoricalWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:WgsDfe.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Recuperação histórica" Background="{StaticResource CanvasBrush}">
 <local:WorkspaceView.Resources><Style TargetType="Button" BasedOn="{StaticResource AppButton}"><Setter Property="Padding" Value="11,5"/><Setter Property="Margin" Value="0,0,6,4"/></Style><Style TargetType="ComboBox" BasedOn="{StaticResource AppComboBox}"><Setter Property="Padding" Value="6,4"/><Setter Property="Margin" Value="0,2,10,4"/></Style></local:WorkspaceView.Resources>
 <Grid Margin="16,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="0.9*" MinHeight="75"/><RowDefinition Height="Auto"/><RowDefinition Height="1.8*" MinHeight="165"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel x:Name="ImportControls" Grid.Row="0" Grid.RowSpan="2">
  <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
   <StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,1"><Ellipse Width="7" Height="7" Fill="#E08A34" VerticalAlignment="Center" Margin="0,0,6,2"/><TextBlock Text="RECUPERAÇÃO &amp; AUDITORIA DE CHAVES FISCAIS · LOTES" Style="{StaticResource Eyebrow}"/></StackPanel><WrapPanel VerticalAlignment="Center"><TextBlock Text="Recuperação Histórica de Chaves" Style="{StaticResource PageTitle}"/><local:PillBadge Text="Lotes de chaves" Margin="10,0,0,2"/><TextBlock Text=" · Auditoria em lote, cruzamento com acervo local e retomada inteligente SEFAZ." Style="{StaticResource Caption}" VerticalAlignment="Center"/></WrapPanel></StackPanel>
   <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="Importar XLSX / CSV / TXT" local:Ui.Icon="&#xE898;" Style="{StaticResource PrimaryButton}" Click="Import_Click"/><Button Content="Modelo de importação" local:Ui.Icon="&#xE896;" Click="Template_Click"/><Button Content="Atualizar lotes" Click="Refresh_Click"/></WrapPanel>
  </Grid>
  <Border Style="{StaticResource Card}" Padding="12,6" Margin="0,0,0,6"><StackPanel><WrapPanel VerticalAlignment="Center"><StackPanel Margin="0,0,8,0"><TextBlock Text="EMPRESA PARA IMPORTAÇÃO / ASSOCIAÇÃO" Style="{StaticResource Eyebrow}"/><ComboBox x:Name="CompanyBox" Width="310" DisplayMemberPath="Name"/></StackPanel><StackPanel Visibility="Collapsed" Margin="0,0,8,0"><TextBlock Text="AMBIENTE DO LOTE" Style="{StaticResource Eyebrow}"/><ComboBox x:Name="EnvironmentBox" Width="160" SelectedIndex="0"><ComboBoxItem Content="Produção"/><ComboBoxItem Content="Homologação"/></ComboBox></StackPanel><StackPanel VerticalAlignment="Bottom" Orientation="Horizontal" Margin="0,0,0,2"><Button Content="Conferir / Retomar lote" Style="{StaticResource PrimaryButton}" Click="Run_Click"/><Button Content="Associar empresa às não associadas" Click="Assign_Click"/><Button Content="Salvar relatório CSV" Click="Report_Click"/></StackPanel></WrapPanel><TextBlock Text="Coluna CHAVE como texto, sem fórmulas (até 100.000 linhas). Use o botão Modelo de importação para baixar a planilha padrão. Empresa automática usa o emitente; selecione uma empresa para chaves de entrada." Style="{StaticResource Caption}" Margin="0,1,0,0"/></StackPanel></Border>
 </StackPanel>
 <Grid Grid.Row="2" Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <Border Style="{StaticResource Card}" Padding="0" CornerRadius="12" ClipToBounds="True"><DataGrid x:Name="BatchesGrid" BorderThickness="0" RowHeight="40" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="Batch_Changed"><DataGrid.Columns><DataGridTextColumn Header="ARQUIVO DO LOTE" Binding="{Binding File}" Width="2*" MinWidth="170" ElementStyle="{StaticResource CellText}"/><DataGridTemplateColumn Header="AMBIENTE" Width="110" MinWidth="95"><DataGridTemplateColumn.CellTemplate><DataTemplate><local:PillBadge Text="{Binding EnvironmentLabel}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="LINHAS" Binding="{Binding Total}" Width="75" MinWidth="65" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="VÁLIDAS ÚNICAS" Binding="{Binding Valid}" Width="105" MinWidth="90" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="INVÁLIDAS" Binding="{Binding Invalid}" Width="80" MinWidth="70" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="DUPLICADAS" Binding="{Binding Duplicates}" Width="90" MinWidth="75" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="DISPONÍVEIS" Binding="{Binding Available}" Width="95" MinWidth="80" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="RESERVAS PAGAS" Binding="{Binding PaidCalls}" Width="110" MinWidth="90" ElementStyle="{StaticResource CellText}"/></DataGrid.Columns></DataGrid></Border>
  <UniformGrid Grid.Column="1" Columns="3" Width="315" Margin="8,0,0,0" DataContext="{Binding SelectedItem, ElementName=BatchesGrid}">
   <UniformGrid.Style><Style TargetType="UniformGrid"><Style.Triggers><DataTrigger Binding="{Binding SelectedItem, ElementName=BatchesGrid}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></UniformGrid.Style>
   <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="0,0,6,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Available}" FontSize="17" FontWeight="SemiBold" Foreground="#065F46"/><TextBlock Text="No acervo" FontSize="10.5" FontWeight="SemiBold" Foreground="#047857"/></StackPanel></Border>
   <Border Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="0,0,6,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Valid}" FontSize="17" FontWeight="SemiBold" Foreground="#3730A3"/><TextBlock Text="Válidas únicas" FontSize="10.5" FontWeight="SemiBold" Foreground="#4338CA"/></StackPanel></Border>
   <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="10" Padding="10,6"><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Total}" FontSize="17" FontWeight="SemiBold" Foreground="#B45309"/><TextBlock Text="Linhas lote" FontSize="10.5" FontWeight="SemiBold" Foreground="#D97706"/></StackPanel></Border>
  </UniformGrid>
 </Grid>
 <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12,5" Margin="0,0,0,6"><StackPanel x:Name="Actions"><Expander Header="Provedor histórico e opções pagas"><WrapPanel Margin="0,2,0,2"><CheckBox x:Name="OfficialBox" IsChecked="True" Content="Tentar fontes oficiais aplicáveis" Margin="0,2,14,4"/><CheckBox x:Name="HistoricalBox" Content="Usar provedor histórico" Margin="0,2,10,4"/><ComboBox x:Name="ProviderBox" Width="180" DisplayMemberPath="Code"/><CheckBox x:Name="PaidBox" Content="Autorizar chamadas pagas" Margin="0,2,10,4"/><TextBlock Text="Limite total no lote:" VerticalAlignment="Center"/><TextBox x:Name="PaidLimitBox" Text="0" Width="60" Padding="4" Margin="6,0,0,4"/></WrapPanel></Expander><TextBlock x:Name="ProviderNotice" Style="{StaticResource Caption}" Margin="0,1,0,0"/><CheckBox x:Name="NetworkBox" Visibility="Collapsed" IsChecked="True"/></StackPanel></Border>
 <TabControl Grid.Row="4"><TabItem Header="Chaves e resultados"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid x:Name="RowsGrid" RowHeight="42" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="LINHA" Binding="{Binding Line}" Width="58" ElementStyle="{StaticResource CellText}" MinWidth="50"/><DataGridTextColumn Header="CHAVE / ENTRADA (44 DÍGITOS)" Binding="{Binding Input}" Width="310" MinWidth="250"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CellText}"><Setter Property="FontFamily" Value="{x:Static local:Typography.Mono}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#14161B"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTemplateColumn Header="MODELO" Width="76" MinWidth="65"><DataGridTemplateColumn.CellTemplate><DataTemplate><local:PillBadge Text="{Binding Model}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="EMPRESA" Binding="{Binding Company}" Width="155" ElementStyle="{StaticResource CellText}" MinWidth="125"/><DataGridTextColumn Header="RESULTADO / DIAGNÓSTICO" Binding="{Binding Result}" Width="*" MinWidth="210"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Foreground" Value="#14161B"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="PROVEDOR" Binding="{Binding Provider}" Width="110" ElementStyle="{StaticResource CellText}" MinWidth="90"/><DataGridTextColumn Header="TENTATIVAS" Binding="{Binding Attempts}" Width="80" ElementStyle="{StaticResource CellText}" MinWidth="70"/><DataGridTextColumn Header="RETOMAR APÓS (UTC)" Binding="{Binding NextAllowedAtUtc, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="135" ElementStyle="{StaticResource CellText}" MinWidth="120"/></DataGrid.Columns></DataGrid><WrapPanel Grid.Row="1" Margin="0,5,0,0" x:Name="Pager"><Button Content="Anterior" Click="Previous_Click"/><TextBlock x:Name="PageText" VerticalAlignment="Center" FontWeight="SemiBold" Margin="4,0,10,2"/><Button Content="Próxima" Click="Next_Click"/></WrapPanel></Grid></TabItem><TabItem Header="Classificação por empresa / emitente / mês"><DataGrid x:Name="GroupsGrid" RowHeight="42" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="EMPRESA" Binding="{Binding Company}" Width="*" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="EMITENTE (CNPJ)" Binding="{Binding Issuer}" Width="180" ElementStyle="{StaticResource CellText}" MinWidth="160"/><DataGridTextColumn Header="MODELO" Binding="{Binding Model}" Width="90" ElementStyle="{StaticResource CellText}" MinWidth="80"/><DataGridTextColumn Header="ANO" Binding="{Binding Year}" Width="75" ElementStyle="{StaticResource CellText}" MinWidth="65"/><DataGridTextColumn Header="MÊS" Binding="{Binding Month}" Width="75" ElementStyle="{StaticResource CellText}" MinWidth="65"/><DataGridTextColumn Header="CHAVES ÚNICAS" Binding="{Binding Count}" Width="125" ElementStyle="{StaticResource CellText}" MinWidth="110"/></DataGrid.Columns></DataGrid></TabItem></TabControl>
 <Border Grid.Row="5" Background="{StaticResource SoftBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="12,5"><StackPanel><DockPanel><Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancelar operação" IsEnabled="False" Click="Cancel_Click" Margin="6,0,0,0"/><TextBlock x:Name="Message" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="Medium" Foreground="#14161B"/></DockPanel><ProgressBar x:Name="BusyBar" IsIndeterminate="True" Visibility="Collapsed" Height="3" Margin="0,4,0,0"/><TextBlock Text="Chave não garante XML disponível. Pedidos externos pendentes são retomados, sem espera automática nesta tela." Style="{StaticResource Caption}" Margin="0,2,0,0"/></StackPanel></Border>
 </Grid>
</local:WorkspaceView>