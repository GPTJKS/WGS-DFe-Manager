<local:WorkspaceView x:Class="WgsDfe.Desktop.CompanyEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:WgsDfe.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Cadastro de empresa" Background="{StaticResource CanvasBrush}">
 <local:WorkspaceView.Resources><Style TargetType="TextBox" BasedOn="{StaticResource AppTextBox}"><Setter Property="Margin" Value="0,4,0,12"/></Style><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></local:WorkspaceView.Resources>
 <Grid Margin="22,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel Margin="0,0,0,14"><StackPanel Orientation="Horizontal" Margin="0,0,0,2"><Ellipse Width="8" Height="8" Fill="#E08A34" VerticalAlignment="Center" Margin="0,0,6,4"/><TextBlock Text="CADASTRO DE EMITENTE / FILIAL" Style="{StaticResource Eyebrow}"/></StackPanel><TextBlock Text="Dados da Empresa" Style="{StaticResource PageTitle}"/><TextBlock Text="Consulte o CNPJ e adicione o certificado neste cadastro." Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/></StackPanel>
 <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Form" Margin="0,0,12,0">
 <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,12"><StackPanel>
 <TextBlock Text="IDENTIFICAÇÃO" Style="{StaticResource Eyebrow}" Margin="0,0,0,12"/>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CNPJ *"/><TextBox x:Name="CnpjBox" MaxLength="18" TextChanged="Cnpj_Changed" ToolTip="CNPJ completo, com ou sem máscara"/></StackPanel><Button Grid.Column="1" x:Name="LookupButton" Content="Consultar CNPJ" Click="Lookup_Click" Margin="12,0,0,12" VerticalAlignment="Bottom"/></Grid>
 <TextBlock x:Name="LookupStatus" Text="Dados públicos da Receita via BrasilAPI / ReceitaWS. Confira os dados retornados; podem estar desatualizados." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,12"/>
 <TextBlock Text="Razão social *"/><TextBox x:Name="LegalNameBox" MaxLength="300"/><TextBlock Text="Nome fantasia"/><TextBox x:Name="TradeNameBox" MaxLength="300"/>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="UF *"/><ComboBox x:Name="StateBox" Margin="0,4,0,12"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Município"/><TextBox x:Name="CityBox" MaxLength="150"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Inscrição estadual"/><TextBox x:Name="RegistrationBox" MaxLength="40"/></StackPanel></Grid>
 <CheckBox x:Name="ActiveBox" Content="Empresa ativa"/>
 </StackPanel></Border>
 <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,12"><StackPanel>
 <TextBlock Text="CERTIFICADO DIGITAL A1" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
 <TextBlock x:Name="CertificateStatus" Text="Opcional agora. Você também pode adicioná-lo ao editar a empresa." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/>
 <WrapPanel><Button Content="Selecionar certificado .pfx / .p12" Click="SelectCertificate_Click"/><Button Content="Descartar seleção" Click="ClearCertificate_Click"/></WrapPanel>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="Senha do certificado"/><PasswordBox x:Name="CertificatePassword" MaxLength="4096" Margin="0,4,0,8" PasswordChanged="Password_Changed"/></StackPanel><Button Grid.Column="1" Content="Validar certificado" Click="ValidateCertificate_Click" VerticalAlignment="Bottom"/></Grid>
 <TextBlock Text="Ao salvar: confere o e-CNPJ e vincula automaticamente às consultas nacionais NF-e e CT-e/OS. Nas fontes de SC, o certificado do contador continua sendo gerenciado separadamente." FontSize="11" Foreground="{StaticResource MutedBrush}"/>
 </StackPanel></Border>
 <Border Style="{StaticResource Card}" Padding="18,16"><StackPanel>
 <TextBlock Text="DOCUMENTOS HABILITADOS" Style="{StaticResource Eyebrow}"/>
 <WrapPanel Margin="0,12,0,8"><CheckBox x:Name="NfeBox" Content="NF-e" Margin="0,0,18,6"/><CheckBox x:Name="NfceBox" Content="NFC-e" Margin="0,0,18,6"/><CheckBox x:Name="CteBox" Content="CT-e" Margin="0,0,18,6"/><CheckBox x:Name="CteOsBox" Content="CT-e OS" Margin="0,0,18,6"/><CheckBox x:Name="NfcomBox" Content="NFCom" Margin="0,0,0,6"/></WrapPanel>
 <Expander Header="Opções adicionais" Margin="0,8,0,0"><StackPanel Margin="0,12,0,0"><TextBlock Text="Subpasta do acervo (opcional)"/><TextBox x:Name="StorageBox" MaxLength="200"/><TextBlock Text="Observações"/><TextBox x:Name="NotesBox" MaxLength="4000" AcceptsReturn="True" TextWrapping="Wrap" Height="70" VerticalScrollBarVisibility="Auto"/></StackPanel></Expander>
 <TextBlock x:Name="MetadataText" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,12,0,0"/>
 </StackPanel></Border>
 </StackPanel></ScrollViewer>
 <StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock x:Name="ErrorText" Foreground="#BE123C" Margin="0,0,0,8" MaxHeight="70"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelButton" Content="Cancelar" Click="Cancel_Click"/><Button x:Name="SaveButton" Content="Salvar empresa" Style="{StaticResource PrimaryButton}" Click="Save_Click" Margin="0"/></StackPanel></StackPanel>
 </Grid>
</local:WorkspaceView>