<local:WorkspaceView x:Class="WgsDfe.Desktop.CertificateWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:WgsDfe.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Certificados digitais A1" Background="{StaticResource CanvasBrush}">
 <local:WorkspaceView.Resources><Style TargetType="Button" BasedOn="{StaticResource AppButton}"><Setter Property="Padding" Value="13,7"/><Setter Property="Margin" Value="0,0,8,8"/></Style></local:WorkspaceView.Resources>
 <Grid Margin="{StaticResource PageInset}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,2"><Ellipse Width="8" Height="8" Fill="#E08A34" VerticalAlignment="Center" Margin="0,0,6,4"/><TextBlock Text="SEGURANÇA CRIPTOGRÁFICA · COFRE WINDOWS DPAPI" Style="{StaticResource Eyebrow}"/></StackPanel><TextBlock Text="Certificados Digitais A1" Style="{StaticResource PageTitle}"/><TextBlock Text="Proteção local pelo perfil do Windows. Alerta automático a partir de 30 dias do vencimento." Style="{StaticResource Caption}" Margin="0,4,0,14"/></StackPanel>
 <WrapPanel Grid.Row="1" x:Name="ImportPanel"><Button Content="Adicionar certificado A1" local:Ui.Icon="&#xE710;" Style="{StaticResource PrimaryButton}" Click="Add_Click"/><Button Content="Substituir selecionado" Click="Replace_Click"/></WrapPanel><TextBlock Grid.Row="2" x:Name="Alerts" TextWrapping="Wrap" Foreground="#BE123C" FontWeight="SemiBold" Margin="0,0,0,10"/>
 <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0" ClipToBounds="True"><DataGrid x:Name="CertificatesGrid" BorderThickness="0" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" SelectionChanged="Selection_Changed"><DataGrid.Columns><DataGridTextColumn Header="Nome" Binding="{Binding Label}" Width="*" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="Finalidade" Binding="{Binding Purpose}" Width="180" ElementStyle="{StaticResource CellText}" MinWidth="180"/><DataGridTextColumn Header="CPF/CNPJ do titular" Binding="{Binding Holder}" Width="200" ElementStyle="{StaticResource CellText}" MinWidth="200"/><DataGridTextColumn Header="Válido até (UTC)" Binding="{Binding ValidToUtc, StringFormat=dd/MM/yyyy HH:mm}" Width="135" ElementStyle="{StaticResource CellText}" MinWidth="135"/><DataGridTemplateColumn Header="Validade" Width="165" MinWidth="160"><DataGridTemplateColumn.CellTemplate><DataTemplate><local:PillBadge Text="{Binding Status}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Border>
 <StackPanel Grid.Row="4" Margin="0,12,0,0"><TextBlock x:Name="Details" TextWrapping="Wrap" Foreground="#14161B"/><WrapPanel x:Name="Actions" Margin="0,10,0,0"><Button Content="Testar chave privada" Click="Test_Click"/><Button Content="Usar nas consultas SC" Click="DefaultAccountant_Click" ToolTip="Escolha uma vez o certificado do contador. Ele será usado nas consultas SC de todas as empresas."/><Button Content="Gerenciar vínculos" Click="Links_Click"/><Button Content="Remover" Click="Remove_Click"/><Button Content="Atualizar / limpar pendências" Click="Refresh_Click"/></WrapPanel></StackPanel>
 <StackPanel Grid.Row="5"><ProgressBar x:Name="BusyBar" Height="4" IsIndeterminate="True" Visibility="Collapsed"/><TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#14161B"/><TextBlock Text="O teste é local. Cadeia de confiança, revogação e autorização fiscal serão verificadas nas integrações." TextWrapping="Wrap" Foreground="#646059" FontSize="12" Margin="0,8,0,0"/></StackPanel>
 </Grid>
</local:WorkspaceView>