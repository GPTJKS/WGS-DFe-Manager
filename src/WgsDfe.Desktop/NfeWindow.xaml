<local:WorkspaceView x:Class="WgsDfe.Desktop.NfeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:WgsDfe.Desktop" Title="Consulta e download de NF-e" Background="{StaticResource CanvasBrush}">
 <local:WorkspaceView.Resources><Style TargetType="Button" BasedOn="{StaticResource AppButton}"><Setter Property="Padding" Value="11,5"/><Setter Property="Margin" Value="0,0,6,4"/></Style><Style TargetType="ComboBox" BasedOn="{StaticResource AppComboBox}"><Setter Property="Padding" Value="7,4"/><Setter Property="Margin" Value="0,2,10,4"/></Style></local:WorkspaceView.Resources>

 <Grid x:Name="RootGrid" Margin="16,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Border x:Name="TopBanner" Background="{StaticResource SoftBrush}" BorderBrush="#E6E4DD" BorderThickness="1" CornerRadius="10" Padding="12,5" Margin="0,0,0,6"><DockPanel><Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="7" Background="#FFF3E6" Margin="0,0,10,0" VerticalAlignment="Center"><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#E08A34" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><WrapPanel VerticalAlignment="Center"><Ellipse Width="6" Height="6" Fill="#E08A34" VerticalAlignment="Center" Margin="0,0,5,1"/><TextBlock x:Name="Heading" Text="Consultas &amp; Sincronismo SEFAZ" FontFamily="{x:Static local:Typography.Ui}" FontSize="13.5" FontWeight="Bold" Foreground="#14161B" VerticalAlignment="Center"/><TextBlock Text=" · " Foreground="#A8A29E" FontSize="12" VerticalAlignment="Center"/><TextBlock x:Name="SourceNotice" Text="Certificado selecionado automaticamente (Nacional: e-CNPJ da empresa; SC: contador)." Style="{StaticResource Caption}" VerticalAlignment="Center"/></WrapPanel><TextBlock x:Name="PeriodCounts" Visibility="Collapsed" TextWrapping="Wrap" FontSize="11.5" FontWeight="SemiBold" Foreground="#065F46" Margin="0,2,0,0"/></StackPanel></DockPanel></Border>
 <Border x:Name="FilterCard" Grid.Row="1" Style="{StaticResource Card}" Padding="12,6" Margin="0,0,0,6">
  <StackPanel x:Name="Filters">
   <WrapPanel VerticalAlignment="Bottom">
    <ComboBox x:Name="TypeBox" Width="165" SelectedIndex="0" SelectionChanged="Type_Changed" Visibility="Collapsed">
     <ComboBoxItem Content="NF-e"/>
     <ComboBoxItem Content="NFC-e (SC)"/>
     <ComboBoxItem Content="NF-e e NFC-e (SC)"/>
    </ComboBox>
    <ContentControl x:Name="DocumentTypeHost"/>
    <ContentControl x:Name="PeriodFilterHost"/>
   </WrapPanel>
   <Expander x:Name="QueryOptions" Header="Fonte e opções de consulta" Margin="0,2,0,2">
    <StackPanel Margin="0,2,0,2">
     <TextBlock x:Name="FooterNotice" FontSize="11" Text="As datas definem as notas exibidas e exportadas. A distribuição pode receber outros meses para manter a sequência do NSU. XMLs antigos dependem da disponibilidade da SEFAZ." TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="2,0,0,4" Foreground="#646059"/>
     <Grid Margin="0,2,0,2">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="1.2*" MinWidth="135"/>
       <ColumnDefinition Width="0.85*" MinWidth="100"/>
       <ColumnDefinition Width="1.25*" MinWidth="140"/>
       <ColumnDefinition Width="0.9*" MinWidth="105"/>
       <ColumnDefinition Width="1.8*" MinWidth="170"/>
       <ColumnDefinition Width="75"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,8,0">
       <TextBlock Text="Fonte" Style="{StaticResource Eyebrow}"/>
       <ComboBox x:Name="Source" Margin="0" SelectedIndex="1" SelectionChanged="Source_Changed">
        <ComboBoxItem Content="SEF/SC — contador"/>
        <ComboBoxItem Content="Distribuição Nacional"/>
       </ComboBox>
      </StackPanel>
      <StackPanel Visibility="Collapsed" Grid.Column="1" Margin="0,0,8,0">
       <TextBlock Text="Ambiente" Style="{StaticResource Eyebrow}"/>
       <ComboBox x:Name="EnvironmentBox" Margin="0" SelectedIndex="0">
        <ComboBoxItem Content="Produção"/>
        <ComboBoxItem Content="Homologação"/>
       </ComboBox>
      </StackPanel>
      <StackPanel Grid.Column="2" Margin="0,0,8,0">
       <TextBlock Text="Participação (SEF/SC)" Style="{StaticResource Eyebrow}"/>
       <ComboBox x:Name="ActorBox" Margin="0" SelectedIndex="0">
        <ComboBoxItem Content="Emitente ou destinatário"/>
        <ComboBoxItem Content="Emitente"/>
        <ComboBoxItem Content="Destinatário"/>
        <ComboBoxItem Content="Emitente e destinatário"/>
       </ComboBox>
      </StackPanel>
      <StackPanel Grid.Column="3" Margin="0,0,8,0">
       <TextBlock Text="Conteúdo (SEF/SC)" Style="{StaticResource Eyebrow}"/>
       <ComboBox x:Name="ModeBox" Margin="0" SelectedIndex="0">
        <ComboBoxItem Content="XML completo"/>
        <ComboBoxItem Content="Somente chaves"/>
       </ComboBox>
      </StackPanel>
      <StackPanel Grid.Column="4" Margin="0,0,8,0">
       <TextBlock Text="Chave de acesso (opcional)" Style="{StaticResource Eyebrow}"/>
       <TextBox x:Name="KeyBox" MaxLength="100" Padding="6,4" Margin="0" local:Ui.Placeholder="Vazio = continuar pelo NSU salvo" ToolTip="Deixe vazio para continuar a distribuição pelo NSU salvo. Chave exige uma empresa."/>
      </StackPanel>
      <StackPanel Grid.Column="5" Margin="0">
       <TextBlock Text="Lotes" Style="{StaticResource Eyebrow}"/>
       <TextBox x:Name="PagesBox" Text="0" Padding="6,4" Margin="0" MaxLength="3" ToolTip="0 = continuação automática; ou de 1 a 100 lotes por empresa."/>
      </StackPanel>
     </Grid>
    </StackPanel>
   </Expander>
   <WrapPanel Margin="0,2,0,0">
    <Button x:Name="RunButton" Content="Consultar e baixar XMLs" local:Ui.Icon="&#xE896;" Style="{StaticResource PrimaryButton}" Click="Run_Click" Margin="0,0,6,0"/>
    <Button x:Name="CancelButton" Content="Cancelar" IsEnabled="False" Click="Cancel_Click" Margin="0"/>
   </WrapPanel>
  </StackPanel>
 </Border>
 <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition x:Name="CompanyColumn" Width="270" MinWidth="195"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*" MinWidth="300"/></Grid.ColumnDefinitions>
 <Border Style="{StaticResource Card}" Padding="10,8"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Empresas" FontWeight="SemiBold" FontSize="13" Foreground="#14161B"/>
<Grid Margin="0,5,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Grid.Resources><Style TargetType="Button" BasedOn="{StaticResource AppButton}"><Setter Property="Padding" Value="3,3"/><Setter Property="Margin" Value="0"/><Setter Property="FontSize" Value="11"/><Setter Property="MinHeight" Value="36"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/></DataTemplate></Setter.Value></Setter></Style></Grid.Resources>
 <Button x:Name="SelectAllButton" Content="Selecionar todas" Click="All_Click" ToolTip="Selecionar ou desmarcar as empresas visíveis"/>
 <Button Grid.Column="2" x:Name="ShowSelectedButton" Content="Mostrar selecionados" Click="ShowSelected_Click" IsEnabled="{Binding IsEnabled, ElementName=CompaniesGrid}" ToolTip="Alternar entre todas as empresas e somente as selecionadas"/>
</Grid><TextBox x:Name="CompanySearch" local:Ui.Search="True" local:Ui.Placeholder="Nome ou CNPJ" Margin="0,0,0,5" TextChanged="CompanySearch_Changed" ToolTip="Buscar empresa por nome ou CNPJ"/></StackPanel><TextBlock x:Name="SelectionText" DockPanel.Dock="Bottom" Text="Role para ver mais empresas ↓" Style="{StaticResource Caption}" FontSize="11" Margin="0,4,0,0"/><AdornerDecorator ClipToBounds="True"><DataGrid RowHeight="42" HeadersVisibility="None" BorderThickness="0" HorizontalScrollBarVisibility="Disabled" RowBackground="#FAF9F6" AlternatingRowBackground="#FAF9F6" x:Name="CompaniesGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" CanUserAddRows="False" SelectionChanged="Companies_Changed"><DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridRow"><Border x:Name="RowCard" CornerRadius="8" Margin="0,1.5" Background="{TemplateBinding Background}" BorderBrush="#ECEAE4" BorderThickness="1" SnapsToDevicePixels="True"><DataGridCellsPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowCard" Property="Background" Value="#F3F2EE"/><Setter TargetName="RowCard" Property="BorderBrush" Value="#D8D4CA"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="RowCard" Property="Background" Value="#ECFDF5"/><Setter TargetName="RowCard" Property="BorderBrush" Value="#6EE7B7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></DataGrid.RowStyle><DataGrid.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="Padding" Value="6,3"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/></Trigger></Style.Triggers></Style></DataGrid.CellStyle><DataGrid.Columns><DataGridTemplateColumn Header="EMPRESAS VINCULADAS" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><local:CompanyCheckBox IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}, Mode=OneWay}" Margin="0" VerticalAlignment="Center" ToolTip="Selecionar empresa"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#14161B" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Text="{Binding Cnpj}" FontFamily="{x:Static local:Typography.Mono}" FontSize="10.5" Foreground="{StaticResource MutedBrush}"/></StackPanel><Border Grid.Column="2" Style="{StaticResource StatusBadge}" Padding="5,1" VerticalAlignment="Center"><TextBlock Text="{Binding State}" Style="{StaticResource BadgeText}" FontSize="10"/></Border></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></AdornerDecorator></DockPanel></Border>
 <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#E6E4DD"/>
 <TabControl Grid.Column="2" x:Name="ResultTabs"><TabItem Header="Notas por período"><local:PeriodDocumentsPanel x:Name="Period"/></TabItem><TabItem Header="Resultado e diagnóstico"><DockPanel>
  <Border x:Name="DiagnosticPreviewCard" DockPanel.Dock="Bottom" Background="#FAF9F6" BorderBrush="#E4E1D8" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,6,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Border Background="#E08A34" CornerRadius="2" Margin="0,2,8,2"/>
   <StackPanel Grid.Column="1" VerticalAlignment="Center">
    <WrapPanel Margin="0,0,0,3" VerticalAlignment="Center">
     <TextBlock x:Name="DiagnosticHeadline" Text="Resultado da consulta" FontSize="12.5" FontWeight="Bold" Foreground="#14161B" VerticalAlignment="Center" Margin="0,0,8,0"/>
       </WrapPanel>
    <TextBlock x:Name="DiagnosticDetail" Text="Selecione o resultado de uma empresa na tabela acima (ou dê duplo clique) para ler o diagnóstico detalhado e o horário de liberação." FontSize="12.5" FontWeight="Medium" Foreground="#4A4742" TextWrapping="Wrap"/>
   </StackPanel>
   <Button Grid.Column="2" Content="Ver diagnóstico" local:Ui.Icon="&#xE946;" Style="{StaticResource PrimaryButton}" Click="Diagnostic_Click" VerticalAlignment="Center" Margin="10,0,0,0"/>
  </Grid></Border>
  <AdornerDecorator ClipToBounds="True"><DataGrid x:Name="ResultsGrid" RowHeight="NaN" MinRowHeight="44" FontSize="13" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="ResultsGrid_SelectionChanged" MouseDoubleClick="Diagnostic_Click"><DataGrid.Columns>
   <DataGridTextColumn Header="Empresa" Binding="{Binding Company}" Width="140" MinWidth="105"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#14161B"/><Setter Property="Padding" Value="2,3"/><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
   <DataGridTextColumn Header="Resultado / horário de liberação" Binding="{Binding Result}" Width="2*" MinWidth="175"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#14161B"/><Setter Property="Padding" Value="2,3"/><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
   <DataGridTextColumn Header="Próxima tentativa (local)" Binding="{Binding NextAllowedAtLocal, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Width="130" MinWidth="110"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CellText}"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12.5"/><Setter Property="Foreground" Value="#047857"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
   <DataGridTextColumn Visibility="Collapsed" Header="cStat" Binding="{Binding CStat}" Width="54" MinWidth="46"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CellText}"><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="12.5"/><Setter Property="Foreground" Value="#14161B"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
   <DataGridTextColumn Header="Lotes" Binding="{Binding Pages}" Width="46" MinWidth="40" ElementStyle="{StaticResource CellText}"/>
   <DataGridTextColumn Header="XMLs" Binding="{Binding Documents}" Width="48" MinWidth="42"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CellText}"><Setter Property="FontWeight" Value="Bold"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
   <DataGridTextColumn Header="Chaves/resumos" Binding="{Binding Summaries}" Width="92" MinWidth="80" ElementStyle="{StaticResource CellText}"/>
   <DataGridTextColumn Header="Fonte / filtros" Binding="{Binding Provider}" Width="95" MinWidth="75" ElementStyle="{StaticResource CellText}"/>
   <DataGridTextColumn Visibility="Collapsed" Header="Código técnico" Binding="{Binding Code}" Width="125" MinWidth="100"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="11.5"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Foreground" Value="#646059"/><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
  </DataGrid.Columns></DataGrid></AdornerDecorator>
 </DockPanel></TabItem></TabControl></Grid>
 <StackPanel Grid.Row="3"><ProgressBar x:Name="BusyBar" IsIndeterminate="True" Height="3" Visibility="Collapsed" Margin="0,4,0,0"/><TextBlock x:Name="ElapsedStatus" FontWeight="SemiBold" FontSize="11.5" Foreground="#646059" Margin="0,2,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock><ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="44"><TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,3,0,0" FontSize="12" FontWeight="Medium" Foreground="#14161B"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock></ScrollViewer></StackPanel>
 </Grid>
</local:WorkspaceView>
