<local:WorkspaceView x:Class="WgsDfe.Desktop.CertificateImportView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:WgsDfe.Desktop" Title="Adicionar certificado A1">
 <Grid Margin="22,16"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Fields" Margin="0,0,8,0">
   <Border Style="{StaticResource Notice}"><DockPanel><TextBlock Text="&#xE83D;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{StaticResource Accent}" Margin="0,0,14,0"/><StackPanel><TextBlock Text="Certificado digital A1" Style="{StaticResource SectionTitle}"/><TextBlock Text="Escolha o arquivo, confira o nome e informe a senha. A chave será validada antes de proteger o certificado no seu perfil do Windows." Style="{StaticResource Caption}"/></StackPanel></DockPanel></Border>
   <TextBlock Text="1. ARQUIVO DO CERTIFICADO" Style="{StaticResource Eyebrow}"/>
   <Border Style="{StaticResource Card}" Margin="0,4,0,16"><StackPanel><DockPanel><Button Content="Escolher arquivo PFX / P12" DockPanel.Dock="Right" Click="Choose_Click"/><TextBlock x:Name="SelectedFile" Text="Nenhum arquivo selecionado" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel><TextBlock Text="Arquivos .pfx ou .p12 · até 5 MiB · certificado com uma chave privada" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel></Border>
   <TextBlock Text="2. IDENTIFICAÇÃO E FINALIDADE" Style="{StaticResource Eyebrow}"/>
   <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="Nome do cadastro" Margin="0,0,0,4"/><TextBox x:Name="LabelBox" MaxLength="200" local:Ui.Placeholder="Ex.: Certificado do escritório" TextChanged="Changed"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Finalidade declarada" Margin="0,0,0,4"/><ComboBox x:Name="UseBox" SelectedIndex="0" SelectionChanged="Changed"><ComboBoxItem Content="Empresa participante"/><ComboBoxItem Content="Escritório / contador"/></ComboBox></StackPanel></Grid>
   <TextBlock Text="3. SENHA DO ARQUIVO" Style="{StaticResource Eyebrow}" Margin="0,18,0,4"/><PasswordBox x:Name="Password" MaxLength="4096" PasswordChanged="Changed"/>
   <TextBlock Text="Se o arquivo não tiver senha, deixe este campo vazio." Style="{StaticResource Caption}" Margin="0,6,0,12"/>

  </StackPanel></ScrollViewer>
  <Border Grid.Row="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,12,0,0"><StackPanel>   <Border x:Name="Feedback" Style="{StaticResource Notice}" Visibility="Collapsed"><StackPanel><TextBlock x:Name="FeedbackTitle" FontWeight="SemiBold"/><TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border><ProgressBar x:Name="Progress" Visibility="Collapsed" IsIndeterminate="True" Height="3" Margin="0,0,0,10"/><WrapPanel HorizontalAlignment="Right"><Button x:Name="CancelButton" Content="Cancelar" Click="Cancel_Click"/><Button x:Name="SaveButton" Content="Validar e adicionar certificado" Style="{StaticResource PrimaryButton}" Click="Save_Click"/></WrapPanel></StackPanel></Border>
 </Grid>
</local:WorkspaceView>
