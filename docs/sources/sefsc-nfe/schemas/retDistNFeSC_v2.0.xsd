<?xml version="1.0"?>
<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="http://www.satnfe.sef.sc.gov.br/ws/distribuicao-v2" targetNamespace="http://www.satnfe.sef.sc.gov.br/ws/distribuicao-v2" >
  <xs:element name="retDistNFeSC">
      <xs:complexType>
        <xs:sequence>
          <xs:element name="tpAmb" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Identificação do Ambiente: 1=Produção /2=Homologação</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
              <xs:restriction base="xs:int" >              
                <xs:enumeration value="1"/>
                <xs:enumeration value="2"/>
              </xs:restriction>
            </xs:simpleType>
          </xs:element> 

          <xs:element name="verAplic" minOccurs="0">
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>Versão da aplicação que solicitou distribuição</xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:string">              
                <xs:minLength value="1"/>
                <xs:maxLength value="20"/>
              </xs:restriction>
            </xs:simpleType>
          </xs:element>

          <xs:element name="cStat">
            <xs:annotation>
              <xs:documentation>Código do status da resposta</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
              <xs:restriction base="xs:int" >              
                <xs:minInclusive value="0"/>
                <xs:maxInclusive value="9999"/>
              </xs:restriction>
            </xs:simpleType>
          </xs:element> 

          <xs:element name="xMotivo">
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>Descrição literal do status da resposta</xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:string">              
                <xs:minLength value="1"/>
                <xs:maxLength value="255"/>
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          
          <xs:element name="dhResp">
          	<xs:simpleType>
                <xs:annotation>
                  <xs:documentation>Data e Hora, formato UTC (AAAA-MM-DDThh:mm:ssTZD, onde TZD = +hh:mm ou -hh:mm)</xs:documentation>
                </xs:annotation>
                <xs:restriction base="xs:string">
                  <xs:whiteSpace value="preserve"/>
                  <xs:pattern value="\d{4}(-\d\d(-\d\d(T\d\d:\d\d(:\d\d)?(\.\d+)?(([+-]\d\d:\d\d)|Z)?)?)?)?"/>
                </xs:restriction>
            </xs:simpleType>
          </xs:element>

          <xs:element name="cUF" minOccurs="0">
            <xs:simpleType>
              <xs:restriction base="xs:integer">
                <xs:minInclusive value="0"/>
                <xs:maxInclusive value="99"/>
              </xs:restriction>
            </xs:simpleType>
          </xs:element>        

            <xs:element name="CPF" minOccurs="0" >
              <xs:simpleType>
                <xs:annotation>
                  <xs:documentation>CPF do contribuinte consultado</xs:documentation>
                </xs:annotation>
                <xs:restriction base="xs:string">
                  <xs:whiteSpace value="preserve"/>
                  <xs:maxLength value="11"/>
                  <xs:pattern value="\s*|[0-9]{3,11}"/>
                </xs:restriction>
              </xs:simpleType>
            </xs:element>

            <xs:element name="CNPJ"  minOccurs="0">
              <xs:simpleType>
                <xs:annotation>
                  <xs:documentation>CNPJ do Estabelecimento consultado</xs:documentation>
                </xs:annotation>
                <xs:restriction base="xs:string">
                  <xs:whiteSpace value="preserve"/>
                  <xs:maxLength value="14"/>
                  <xs:pattern value="\s*|[0-9A-Z]{3,14}"/>
                </xs:restriction>
              </xs:simpleType>
            </xs:element>

        <xs:choice>
              <xs:sequence>
                <xs:element name="indXML" minOccurs="0" >
                  <xs:simpleType>
                    <xs:restriction base="xs:integer">
                      <xs:annotation>
                        <xs:documentation>0=Somente Chaves de Acesso; 1=Solicitado o XML do DF-e</xs:documentation>
                      </xs:annotation>
                      <xs:enumeration value="0"/>
                      <xs:enumeration value="1"/>
                    </xs:restriction>
                  </xs:simpleType>
                </xs:element>
                
                <xs:element name="indAtor" minOccurs="0">
                  <xs:simpleType>
                    <xs:restriction base="xs:integer">
                      <xs:annotation>
                        <xs:documentation>1=Emitente, 2=Destinatário, 3=Todos, 9=Ambos</xs:documentation>
                      </xs:annotation>
                      <xs:enumeration value="1"/>
                      <xs:enumeration value="2"/>
                      <xs:enumeration value="3"/>
                      <xs:enumeration value="9"/>
                    </xs:restriction>
                  </xs:simpleType>
                </xs:element>

                <xs:element name="ultNuNSU" minOccurs="0" >
                  <xs:simpleType>
                    <xs:annotation>
                      <xs:documentation>Último número NSU que o Requisitante já possui. O serviço de distribuição irá fornecer os documentos após o ultNuNSU informado, que estejam dentro do período de download.</xs:documentation>
                    </xs:annotation>
                    <xs:restriction base="xs:long">
                      <xs:totalDigits value="18"/>
                    </xs:restriction>
                  </xs:simpleType>
                </xs:element>

              </xs:sequence>
              <xs:element name="chAcesso" >
                  <xs:simpleType>
                    <xs:restriction base="xs:string" id="idChave">
                      <xs:annotation>
                        <xs:documentation>Chave de Acesso informada</xs:documentation>
                      </xs:annotation>
                      <xs:whiteSpace value="preserve"/>
                      <xs:pattern value="[0-9A-Z]{44}"/>
                    </xs:restriction>
                  </xs:simpleType>
                </xs:element>
        </xs:choice>
          
          <xs:element name="ultNuNSURet" minOccurs="0" >
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>Último NSU retornado no campo loteDistComp</xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:long">
                <xs:totalDigits value="18"/>
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          
          <xs:element name="qtDfeRet" minOccurs="0">
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>Quantidade de DFe retornadas</xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:long">
                <xs:totalDigits value="2"/>
              </xs:restriction>
            </xs:simpleType>
          </xs:element>

          <xs:element name="loteDistComp" minOccurs="0">
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>Conjunto DF-e compactado. (Tipo campo: base64Binary)</xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:base64Binary"/>
            </xs:simpleType>
          </xs:element>

        </xs:sequence>
        <xs:attribute name="versao" use="required">
          <xs:simpleType >
            <xs:restriction base="xs:string">
              <xs:annotation>
                <xs:documentation>Versão do leiaute</xs:documentation>
              </xs:annotation>
              <xs:pattern value="\w*\.\w*"/>
              <xs:maxLength value="5"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:attribute>
      </xs:complexType>


  </xs:element>
</xs:schema>
